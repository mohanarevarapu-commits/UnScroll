<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Cosmic Thermal Aurora Base (#0B0E1D) -->
    <path
        android:fillColor="#0B0E1D"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Top-Left Teal-Mint Aurora Glow -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="30"
                android:centerY="28"
                android:gradientRadius="64"
                android:type="radial">
                <item
                    android:color="#552FC4B2"
                    android:offset="0.0" />
                <item
                    android:color="#224FE3A0"
                    android:offset="0.55" />
                <item
                    android:color="#000B0E1D"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom-Right Soft Violet Aurora Glow -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="78"
                android:centerY="80"
                android:gradientRadius="60"
                android:type="radial">
                <item
                    android:color="#4DA98BFF"
                    android:offset="0.0" />
                <item
                    android:color="#000B0E1D"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
