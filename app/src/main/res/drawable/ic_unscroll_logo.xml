<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Cosmic Circular Badge (#0B0E1D) with Glass Border -->
    <path
        android:fillColor="#0B0E1D"
        android:pathData="M54,8 A46,46 0 1,1 53.99,8 Z"
        android:strokeWidth="2"
        android:strokeColor="#38FFFFFF" />

    <!-- Subtle Inner Aurora Glow -->
    <path android:pathData="M54,10 A44,44 0 1,1 53.99,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="38"
                android:centerY="34"
                android:gradientRadius="56"
                android:type="radial">
                <item
                    android:color="#402FC4B2"
                    android:offset="0.0" />
                <item
                    android:color="#26A98BFF"
                    android:offset="0.6" />
                <item
                    android:color="#000B0E1D"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- "U" of US (UnScroll) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M28,39 L28,58 C28,65.5 32.8,70 38.8,70 C44.8,70 49.5,65.5 49.5,58 L49.5,39.5"
        android:strokeWidth="6.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="49.5"
                android:endY="70"
                android:startX="28"
                android:startY="38"
                android:type="linear">
                <item
                    android:color="#4FE3A0"
                    android:offset="0.0" />
                <item
                    android:color="#2FC4B2"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upward Arrow Tip on the right stem of "U" -->
    <path
        android:fillColor="#00000000"
        android:pathData="M45.2,43.2 L49.5,38 L53.8,43.2"
        android:strokeWidth="4.4"
        android:strokeColor="#4FE3A0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- "S" of US (UnScroll) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M79,42.5 C76.8,39.2 73,38 68.8,38 C63.6,38 60.5,41 60.5,45.4 C60.5,50 64.2,52.2 70.2,54.2 C76.2,56.2 80,58.6 80,64 C80,68.5 76,70.5 69.8,70.5 C65,70.5 61.4,68.8 59.5,65.8"
        android:strokeWidth="6.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="80"
                android:endY="70.5"
                android:startX="60.5"
                android:startY="38"
                android:type="linear">
                <item
                    android:color="#2FC4B2"
                    android:offset="0.0" />
                <item
                    android:color="#A98BFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
